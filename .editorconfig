root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,mjs,js,cjs,json,yml,yaml,md}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown 行尾两个空格是换行语法，不能自动裁剪
trim_trailing_whitespace = false

[*.sh]
indent_size = 2
