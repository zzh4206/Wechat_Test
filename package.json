{
  "name": "@zzh4206/dsh-group-lurker",
  "version": "0.2.0",
  "description": "DSH Cordis 插件：只读旁听群聊，提炼关键信息并生成日志。MVP 不发送任何消息。",
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "wechat",
    "readonly",
    "lurker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzh4206/Wechat_Test.git"
  },
  "homepage": "https://github.com/zzh4206/Wechat_Test#readme",
  "bugs": {
    "url": "https://github.com/zzh4206/Wechat_Test/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p lib/personas && cp src/personas/*.md lib/personas/",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
